# ====== 必填 ======
# 找 @BotFather 创建 Bot 后获得
TELEGRAM_BOT_TOKEN=

# OpenAI 兼容 API 的 key 与 base url
# 连本机 new-api 例：OPENAI_BASE_URL=http://127.0.0.1:3001/v1
# 直连 OpenAI 例：  OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:3001/v1

# Tavily 网页搜索 API key（留空则禁用外部搜索工具）
TAVILY_API_KEY=

# 白名单：允许使用 Bot 的 Telegram 数字 user id，逗号分隔
# 不知道自己的 id 可先随便填一个，启动后给 Bot 发消息，日志里会打印你的 id
ALLOWED_USER_IDS=

# ====== 可选 ======
# 默认模型
DEFAULT_MODEL=gpt-4o-mini

# 可切换的模型列表，逗号分隔；留空时启动后会调用 /v1/models 自动获取
AVAILABLE_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,o4-mini,claude-sonnet-4,gemini-2.5-pro,deepseek-chat

# 默认采样参数
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=1.0
DEFAULT_REPEAT_PENALTY=1.0
DEFAULT_MAX_TOKENS=2048

# 上下文最多保留多少条消息（user+assistant 计数），超过会从最旧开始裁剪
MAX_HISTORY_MESSAGES=20

# 当历史消息数达到阈值时，后台自动做“会话摘要压缩”
SUMMARY_TRIGGER_MESSAGES=16

# 当历史估算 token 达到阈值时，也会触发会话摘要（与条数触发二选一满足即可）
SUMMARY_TRIGGER_TOKENS=6000

# 会话摘要专用模型（留空=跟随当前会话模型）
SUMMARY_MODEL=

# 摘要后保留最近多少条原始消息（其余压进会话摘要）
SUMMARY_KEEP_RECENT_MESSAGES=8

# 生成会话摘要时允许的最大输出 token
SUMMARY_MAX_TOKENS=512

# 将会话摘要注入模型上下文时的估算 token 上限（超出会自动截断摘要）
SUMMARY_CONTEXT_MAX_TOKENS=1200

# 单次发给模型的输入估算 token 上限（超出会只保留最近若干条原始消息 + 摘要）
PROMPT_MAX_INPUT_TOKENS=10000

# 触发输入 token 兜底时，最多保留最近多少条原始消息参与本次请求
PROMPT_KEEP_RECENT_MESSAGES=10

# 是否默认开启流式输出 (true/false)
STREAM_DEFAULT=true

# 是否默认尝试启用上游网页搜索能力（模型/网关不支持时会自动回退）
WEB_SEARCH_DEFAULT=false

# 是否默认尝试启用思考模式（模型/网关不支持时会自动回退）
THINKING_DEFAULT=false

# 是否默认尝试启用 Prompt Cache（OpenAI 兼容网关不支持时会自动回退）
PROMPT_CACHE_DEFAULT=false

# Embedding 模型（用于本地 RAG 向量化）
EMBEDDING_MODEL=text-embedding-v3

# 是否默认开启 RAG 检索增强（可在会话内用 /set rag on|off 覆盖）
RAG_ENABLED_DEFAULT=true

# RAG 分块配置
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# RAG 检索配置
RAG_TOP_K=4
RAG_MIN_SCORE=0.35

# 工具框架：启用工具列表（逗号分隔；留空=按工具自身 enabled 判断）
# 例如：TOOLS_ENABLED=web_search
TOOLS_ENABLED=

# 工具框架：每次请求工具调用超时（秒）与最大调用次数
TOOL_TIMEOUT_SECONDS=20
TOOL_MAX_CALLS_PER_REQUEST=2

# 日志级别
LOG_LEVEL=INFO
